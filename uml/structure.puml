@startuml
title DAC-SCADA — Class Diagram (current)

skinparam classAttributeIconSize 0

' ============================================================
' ABSTRACT INTERFACE (communication layer)
' ============================================================

abstract class IModbusClient {
    + {abstract} connectTo(info : DeviceInfo) : bool
    + {abstract} disconnectFrom() : void
    + {abstract} isConnected() : bool
    + {abstract} readHoldingRegisters(startAddr, count) : void
    + {abstract} writeSingleRegister(regAddr, value : quint16) : void
    ..
    signals
    __connectionStateChanged__(connected : bool)
    __registersRead__(unit : QModbusDataUnit)
    __communicationError__(msg : QString)
    __writeSucceeded__(regAddr : int)            ' 写应答已确认
    __writeFailed__(regAddr : int, error : QString)
}

' ============================================================
' TRANSPORT DRIVERS
' ============================================================

class ModbusTcpClient {
    - m_client : QModbusTcpClient*
    - m_host : QString
    - m_port : quint16 = 502
    - m_unitId : int = 1
    - m_pendingReply : QModbusReply*
    - m_pendingReadRequest : bool
    - m_pendingWriteRequest : bool       ' 在途请求为写（驱动 writeSucceeded/Failed）
    - m_pendingWrite : bool          ' 总线忙时延迟补发的写请求
    - m_pendingWriteAddr : int
    - m_pendingWriteValue : quint16
    ..
    + connectTo(info) : bool
    + disconnectFrom() : void
    + isConnected() : bool
    + readHoldingRegisters(startAddr, count) : void
    + writeSingleRegister(regAddr, value) : void
    ..
    slots
    - onStateChanged(state) : void
    - onReplyFinished() : void
    - onErrorOccurred(error) : void
    - sendReadRequest(startAddr, count) : void
    - sendWriteRequest(regAddr, value) : void
}

class ModbusSerialClient {
    - m_client : QModbusRtuSerialClient*
    - m_portName : QString
    - m_baudRate : int = 9600
    - m_unitId : int = 1
    - m_pendingReply : QModbusReply*
    - m_pendingReadRequest : bool
    - m_pendingWriteRequest : bool       ' 在途请求为写（驱动 writeSucceeded/Failed）
    - m_pendingWrite : bool
    - m_pendingWriteAddr : int
    - m_pendingWriteValue : quint16
    ..
    + connectTo(info) : bool
    + disconnectFrom() : void
    + isConnected() : bool
    + readHoldingRegisters(startAddr, count) : void
    + writeSingleRegister(regAddr, value) : void
    ..
    slots
    - onStateChanged(state) : void
    - onReplyFinished() : void
    - onErrorOccurred(error) : void
    - sendReadRequest(startAddr, count) : void
    - sendWriteRequest(regAddr, value) : void
}

' ============================================================
' CORE LAYER
' ============================================================

class DataCollector {
    - m_alarms : AlarmEngine*        ' owned child
    - m_history : HistoryStore*      ' owned child (SQLite)
    - m_queue : SampleQueue          ' producer→consumer, 有界 4096
    - m_devices : QList~DeviceInfo~
    - m_ctx : QVector~DeviceContext*~
    - m_pollTimer : QTimer*          ' QObject 子对象（随 moveToThread 迁移）
    ..
    + loadConfig(jsonPath) : bool
    + connectAll() : void
    + disconnectAll() : void
    + writeRegister(deviceIndex, regAddr, value : quint16) : void
    + startPolling(intervalMs = 100) : void
    + stopPolling() : void
    + queue() : SampleQueue*
    + alarmEngine() : AlarmEngine*
    + historyStore() : HistoryStore*
    + historySamples() : qint64
    ..
    signals
    __deviceConnectionChanged__(deviceIndex, connected)
    __deviceOnlineChanged__(deviceIndex, online)
    __deviceFailCountChanged__(deviceIndex, count)
    __pollingStateChanged__(active)
    __statusMessage__(msg)
    __configLoaded__()
    __writeFinished__(deviceIndex, ok, msg)
    ..
    notes
      * 整对象 moveToThread 到专用 QThread；GUI 绝不直读其状态
      * 三态状态机：链路建立(connected) ≠ 有响应(online)
      * 100ms 轮询 = 心跳；3s 无响应判离线；指数退避 500ms·2^n 封顶 30s
      * 每设备 LinkState{Active,Reconnecting} + manualDisconnect
      * writeRegister 经 m_pendingWrite 在驱动内延迟补发（read 在途不丢写）
      * writeFinished 仅在实际总线应答后发出（writeSucceeded/writeFailed），不再"发出即成功"
    end notes
}

class HistoryStore {
    - m_dbPath : QString
    - m_flushTimer : QTimer*         ' QObject 子对象
    - m_dbOpen : bool
    - m_failed : bool
    - m_totalSamples : atomic~qint64~
    - m_devIdx/regAddr/ts/val : QVector~QVariant~   ' 采样缓冲（列并行）
    - m_alarmTs/Sev/Dev/Msg : QVector~QVariant~     ' 报警缓冲
    ..
    + start() : void
    + addSample(deviceIndex, regAddr, tsMs, value) : void
    + addAlarm(rec : AlarmRecord) : void
    + flush() : bool
    + totalSamples() : qint64
    + querySamples(requestId, deviceIndex, q : HistoryQuery) : void   ' worker 线程
    + queryAlarms(requestId, deviceIndex, startMs, endMs) : void
    ..
    signals
    __samplesReady__(requestId, deviceIndex, rows : HistoryResult)
    __alarmsReady__(requestId, deviceIndex, alarms : QVector~AlarmRecord~)
    ..
    notes
      * 懒打开 <exe>/data/history.db；表 samples / alarms + (device_index,ts) 索引
      * 512 行 或 1s 单事务 execBatch 落盘；查询 LIMIT 20万
      * WAL + auto_vacuum INCREMENTAL；打开时清理 30 天前旧行
      * 与写入同线程（worker），读写天然串行
    end notes
}

class SampleQueue {
    - m_mutex : QMutex
    - m_items : deque~Sample~
    - m_capacity : size_t = 4096
    ..
    + push(s : Sample) : void        ' 生产（采集线程）
    + tryPop(out : Sample) : bool    ' 消费（GUI 线程）
    + size() : int
    ..
    notes
      满则丢最旧——实时曲线只要最新数据
    end notes
}

class AlarmEngine {
    - m_states : QHash~int, QHash~int, TrackedState~~   ' deviceIndex → (regAddr → {committed,pending,consecutive})
    ..
    + checkValue(deviceIndex, ch : Channel, value) : void
    ..
    signals
    __newAlarm__(record : AlarmRecord)
    ..
    notes
      边沿检测 Normal/High/Low；越限触发 Critical/Warning，恢复触发 Info
      防抖：新状态需连续 kDebounceCount=3 个采样才提交（~300ms），抖动不误报
    end notes
}

class AppLogger {
    + {static} install(logDir, minLevel = Info, maxBytes = 1M, maxBackups = 3) : void
    + {static} setMinLevel(level) / minLevel() : Level
    + {static} levelForType(qtMsgType) : Level
    + {static} passes(qtMsgType, minLevel) : bool
    + {static} backupFileName(base, index) : QString
    ..
    notes
      全局消息处理器 → <exe>/data/app.log（时间戳+级别，QMutex 跨线程互斥）；
      分级过滤（--log-level 可调）+ 按大小轮转（app.log → .1 → …，丢弃最旧）；
      纯逻辑静态函数 → test_app_logger 单测
    end notes
}

class DataCache {
    - m_devices : QList~DeviceInfo~
    - m_values : QHash~int, QHash~int, double~~
    - m_currentDevice : int = 0
    - m_model : DataCacheModel*
    ..
    + setDevices(devices) : void
    + setCurrentDevice(deviceIndex) : void
    + currentDevice() : int
    + value(deviceIndex, regAddr) : double
    + hasValue(deviceIndex, regAddr) : bool
    + tableModel() : DataCacheModel*
    + currentChannels() : QList~Channel~
    ..
    signals
    __devicesChanged__()
    __currentDeviceChanged__(deviceIndex)
    __valueChanged__(deviceIndex, regAddr, value, tsMs)
}

class DataCacheModel {
    + rowCount(parent) : int
    + columnCount(parent) : int
    + data(index, role) : QVariant
    + headerData(section, orientation, role) : QVariant
    + notifyRowsReset() : void
    + valueUpdated(regAddr) : void    ' 只刷新受影响行
    ..
    columns
      通道 / 当前值 / 单位 / 状态
}

' ============================================================
' UI LAYER
' ============================================================

class MainViewModel {
    - m_collector : DataCollector*   ' worker 线程（无父对象）
    - m_cache : DataCache*           ' GUI 线程
    - m_model : DataCacheModel*
    - m_worker : QThread*
    - m_drainTimer : QTimer*         ' 50ms 批量排空队列
    - m_status : QVector~DeviceStatus~
    - m_alarmHistory : QVector~AlarmRecord~   ' 封顶 1000
    - m_historyRequestSeq : int
    ..
    + dataModel() : QAbstractTableModel*
    + alarms() : QVector~AlarmRecord~
    + deviceConnected/deviceOnline/deviceFailureCount(idx) : bool/int
    + historySamples() : qint64
    + loadConfig(jsonPath) : void
    + connectToDevice() : void
    + disconnectFromDevice() : void
    + switchDevice(deviceIndex) : void
    + queryHistory(deviceIndex, q : HistoryQuery) : int   ' 返回 requestId
    + queryAlarms(deviceIndex, startMs, endMs) : int
    + writeRegister(deviceIndex, regAddr, value : quint16) : void
    ..
    signals
    __deviceConnectionChanged__(deviceIndex, connected)
    __deviceOnlineChanged__(deviceIndex, online)
    __statusTextChanged__(msg)
    __newAlarm__(record : AlarmRecord)
    __historySamplesReady__(requestId, deviceIndex, rows : HistoryResult)
    __historyAlarmsReady__(requestId, deviceIndex, alarms)
    __writeFinished__(deviceIndex, ok, msg)
    ..
    slots
    - drainSamples() : void
    ..
    notes
      MVVM：跨线程命令经 QMetaObject::invokeMethod（loadConfig 阻塞式，
      其余排队）；值走队列、状态走信号，GUI 不直读 collector
    end notes
}

class MainWindow {
    - m_viewModel : MainViewModel*
    - m_simulator : SimulatedModbusServer*    ' TCP @ 1502
    - m_simulator2 : SimulatedModbusServer*   ' TCP @ 1503
    - m_serialSim : SimulatedSerialServer*    ' 串口 COM6
    - m_deviceTree : QTreeWidget*
    - m_dataTable : QTableView*
    - m_curvePanel : CurvePanel*
    - m_dashPanel : DashboardPanel*
    - m_alarmTable : QTableWidget*
    - m_statusLabel : QLabel*
    - m_historyPanel : HistoryPanel*
    - m_historyDock : QDockWidget*
    ..
    + startSimulatorAutomatically() : bool
    + loadConfiguration(jsonPath) : void
    + connectToDevice() : void
    + runSelfTest(outPath) : void
    + runSelfTestReconnect(outPath) : void
    + runSelfTestHistory(outPath) : void
    + runSelfTestWrite(outPath) : void
    ..
    slots
    - toggleSimulator() : void
    - updateDeviceStatus() : void
    - openWriteRegisterDialog(initialRegAddr = -1) : void
    - appendAlarmRow(time, severity, device, message) : void
}

class CurvePanel {
    - m_plot : QCustomPlot*
    - m_axisX : QCPAxis*             ' QCPAxisTickerDateTime（秒→时钟）
    - m_axisY : QCPAxis*
    - m_graphs : QHash~int, QCPGraph*~   ' regAddr → graph
    - m_windowSeconds : int = 60
    ..
    + setChannels(channels) : void
    + addPoint(regAddr, value, tsMs) : void
    + clear() : void
    + setWindowSeconds(seconds) : void
    ..
    slots
    - onUiTick() : void              ' 50ms 滚动时间窗 + 剔除过期 + 自适应 Y
}

class GaugeWidget {
    - m_name / m_unit : QString
    - m_color : QColor
    - m_lower / m_upper : double     ' 报警上下限
    - m_dialMin / m_dialMax : double ' 表盘量程（限值 ±50% 裕量）
    - m_value : double; m_hasValue : bool
    ..
    + setChannel(ch : Channel) : void
    + setValue(value) : void
    + {static} computeDialRange(lower, upper, &min, &max) : void
    + {static} angleFor(value, dialMin, dialMax) : double
    ..
    notes
      QPainter 手绘圆形表盘：彩色限值弧（绿/琥珀/红）+ 刻度 + 指针 + 数字读数；
      纯几何为静态函数 → test_gauge 单测（无 GUI 依赖）
    end notes
}

class DashboardPanel {
    - m_title : QLabel*
    - m_grid : QGridLayout*
    - m_gauges : QHash~int, GaugeWidget*~   ' regAddr → gauge
    ..
    + setChannels(channels, deviceName) : void
    + updateValue(regAddr, value) : void
    ..
    notes
      当前设备各通道的表盘网格（≤4 单行，多则换行）；
      复用曲线同一套 DataCache 信号通路
    end notes
}

class HistoryPanel {
    - m_vm : MainViewModel*
    - m_devices : QList~DeviceInfo~
    - m_graphs : QHash~int, QCPGraph*~
    - m_lastSamples : HistoryResult
    - m_lastAlarms : QVector~AlarmRecord~
    - m_pendingSampleReq / m_pendingAlarmReq : int
    - m_queryStartMs / m_queryEndMs : qint64
    ..
    + setDevices(devices) : void
    ..
    slots
    - onDeviceChanged(index) : void
    - applyQuery() : void
    - onSamplesReady(requestId, deviceIndex, rows) : void
    - onAlarmsReady(requestId, deviceIndex, alarms) : void
    ..
    notes
      设备/通道(勾选)/时间范围(5/15/60分快捷+起止) → 异步查询；
      Tab1 采样曲线（QCustomPlot 静态回放），Tab2 报警历史；
      导出 CSV（UTF-8 BOM）/ XLSX（QXlsx）；按 requestId+设备索引丢弃过期结果
    end notes
}

class AlarmTableModel {
    + setAlarms(alarms, deviceName) : void
    + rowCount / columnCount / data / headerData
    ..
    columns
      时间 / 级别 / 设备 / 信息
}

class WriteRegisterDialog {
    + deviceIndex() : int
    + regAddr() : int
    + value() : quint16
    ..
    - m_deviceCombo : QComboBox*
    - m_regSpin : QSpinBox*
    - m_valueSpin : QSpinBox*
}

' ============================================================
' SIMULATOR LAYER
' ============================================================

class SimulatedDevice {
    - m_timer : QTimer
    - m_registers : QVector~quint16~
    - m_waveConfigs : QVector~WaveConfig~
    - m_elapsedMs : qint64
    ..
    + setRegisterCount(count) : void
    + setWaveConfig(regAddr, cfg : WaveConfig) : void
    + setUpdateInterval(intervalMs) : void
    + start() / stop() / isRunning() : bool
    + rawRegister(addr) : quint16
    + realValue(addr) : double
    + registerCount() : int
    ..
    signals
    __registersUpdated__()
    ..
    notes
      real = base + amplitude*sin(2π·freq·t) + noise；raw = clamp(round(real*scale))
      20Hz tick；全部寄存器会被覆盖（除非被遥控写入覆盖）
    end notes
}

class SimulatedModbusServer {
    - m_device : SimulatedDevice*
    - m_server : QModbusServer*      ' QModbusTcpServer
    - m_overrides : QHash~int, quint16~   ' 遥控写入保持
    - m_pushing : bool               ' 重入标志（setData 也发 dataWritten）
    ..
    + start(port, host) : bool
    + stop() : void
    + isListening() : bool
    + device() : SimulatedDevice*
    ..
    slots
    - pushRegistersToModbus() : void
    ..
    notes
      dataWritten 只带 (table,address,size) 无值 → 从服务器内部 data() 读回；
      m_pushing 区分"自己的波形 push"与"上位机写入"
    end notes
}

class SimulatedSerialServer {
    - m_device : SimulatedDevice*
    - m_server : QModbusServer*      ' QModbusRtuSerialServer
    - m_overrides : QHash~int, quint16~
    - m_pushing : bool
    ..
    + start(portName, baudRate) : bool
    + stop() : void
    + isListening() : bool
    + device() : SimulatedDevice*
    ..
    slots
    - pushRegistersToModbus() : void
}

' ============================================================
' DATA STRUCTURES (core/types.h)
' ============================================================

class Channel <<struct>> {
    + unit : QString
    + name : QString
    + regAddr : quint16
    + color : QColor
    + upperLimit : double
    + lowerLimit : double
    + scale : double = 1.0
    + offset : double = 0.0
}

class DeviceInfo <<struct>> {
    + address : qint16 = 1
    + name : QString
    + type : QString
    + connType : ConnType = Tcp
    + ip : QString
    + port : quint16 = 502
    + serialPort : QString
    + baudRate : int = 9600
    + online : bool = false
    + channels : QList~Channel~
}

class AlarmRecord <<struct>> {
    + deviceAddr : qint16 = 0
    + timestamp : QDateTime
    + message : QString
    + severity : Severity
    + acknowledged : bool = false
}

class Sample <<struct>> {
    + deviceIndex : int
    + regAddr : int
    + value : double
    + tsMs : qint64
}

class HistoryRow <<struct>> {
    + regAddr : int
    + tsMs : qint64
    + value : double
}

class HistoryQuery <<struct>> {
    + regAddrs : QVector~int~    ' 空 = 全部通道
    + startMs : qint64
    + endMs : qint64
}

class HistoryResult <<struct>> {
    + requestId : int
    + deviceIndex : int
    + rows : QVector~HistoryRow~ ' 按 ts 升序
}

enum ConnType {
    Tcp
    Serial
}

enum Severity {
    Info
    Warning
    Critical
}

