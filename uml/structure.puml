QObject <|-- MainViewModel
QMainWindow <|-- MainWindow
QWidget <|-- CurvePanel
QWidget <|-- HistoryPanel
QAbstractTableModel <|-- AlarmTableModel
QDialog <|-- WriteRegisterDialog

QObject <|-- SimulatedDevice
QObject <|-- SimulatedModbusServer
QObject <|-- SimulatedSerialServer

